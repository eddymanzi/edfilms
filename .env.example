# ============================================================
# EdFilms environment variables
# Copy to .env and fill in real values.
# NEVER commit .env or any real secrets to git.
# ============================================================

# --- Database (PostgreSQL) ---
POSTGRES_USER=edfilms
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=edfilms
DATABASE_URL=postgresql://edfilms:change_me_strong_password@localhost:5432/edfilms

# --- Backend ---
NODE_ENV=production
PORT=5000
# Random string, at least 32 chars: openssl rand -hex 32
JWT_SECRET=change_me_random_32_character_string_here
SITE_URL=https://your-domain.com

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# --- Media storage ---
# Local disk directory (mounted as a persistent volume in prod).
# For large deployments, migrate to object storage (R2/B2) - see DEPLOYMENT.md.
STORAGE_DIR=./backend/storage

# --- Frontend ---
# Leave empty to use the same origin as the frontend (recommended).
VITE_API_URL=

# --- Mobile Money (MTN MoMo) ---
# mock = works locally without credentials (do not ship). Set to "live" and
# fill MOMO_* below once you have real API credentials from MTN.
PAYMENT_MODE=mock
MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_API_KEY=
MOMO_API_SECRET=
MOMO_SUBSCRIPTION_KEY=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CALLBACK_URL=https://your-domain.com/api/payments/momo/callback