# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed frontend origins (production only)
# CORS_ORIGINS=http://localhost:5173
# Public site URL used in the sitemap
# SITE_URL=http://localhost:5173

# Admin auth (production requires >= 32 chars)
JWT_SECRET=change_this_to_a_long_random_string

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/edfilms

# Media storage (defaults to ./storage; production must mount a persistent volume)
# STORAGE_DIR=./storage

# Uploads
MAX_VIDEO_SIZE_MB=4096
MAX_POSTER_SIZE_MB=10

# ============================================================
# PAYMENT CONFIGURATION (MoMo)
# ============================================================
# Provider: momo (MTN MoMo Open API) | PAYMENT_MODE: live or mock
# MOCK MODE IS FOR LOCAL DEVELOPMENT ONLY - never use in production.
PAYMENT_PROVIDER=momo
PAYMENT_MODE=live
PAYMENT_CURRENCY=RWF

# MTN MoMo Open API credentials (leave empty until you obtain them from MTN)
# Register at the official MTN MoMo portal for the Rwanda environment.
# NEVER commit real credentials. Provide them only in your local .env.
MOMO_API_BASE_URL=
MOMO_API_KEY=
MOMO_API_SECRET=
MOMO_SUBSCRIPTION_KEY=
MOMO_TARGET_ENVIRONMENT=
MOMO_CALLBACK_URL=

# Mock mode options (development only)
# MOCK_SETTLE_SECONDS=6
# MOCK_FAILURE_PHONES=0700000000